{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$ref": "#/definitions/Branding",
  "definitions": {
    "Address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1
        },
        "line2": {
          "type": "string",
          "minLength": 1
        },
        "postTown": {
          "type": "string",
          "minLength": 1
        },
        "county": {
          "type": "string",
          "minLength": 1
        },
        "postCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "county",
        "line1",
        "line2",
        "postCode",
        "postTown"
      ]
    },
    "Branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 3,
          "pattern": "[A-Za-z& ]*"
        },
        "map": {
          "$ref": "#/definitions/Map"
        },
        "logoUrl": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "minLength": 3,
          "pattern": "[a-zA-Z,&. ]*"
        },
        "directions": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "$ref": "#/definitions/Contact"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "description",
        "directions",
        "logoUrl",
        "name"
      ]
    },
    "Contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 40,
          "minLength": 3,
          "pattern": "[A-Za-z& ]*"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 1
        }
      },
      "required": [
        "email",
        "name",
        "phone"
      ]
    },
    "Map": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "format": "double"
        },
        "longitude": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    }
  }
}